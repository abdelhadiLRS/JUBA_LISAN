{
  "name": "juba-lisan-frontend",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "dev:electron": "concurrently \"npm run next-dev\" \"wait-on http://localhost:3000 && electron .\"",
    "next-dev": "next dev",
    "build": "next build",
    "build:export": "npm run build",
    "build:electron": "powershell -ExecutionPolicy Bypass -File ../scripts/build-desktop.ps1",
    "start": "next start",
    "start:electron": "electron .",
    "dist": "powershell -ExecutionPolicy Bypass -File ../scripts/build-desktop.ps1",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "lint": "eslint",
    "test": "vitest",
    "test:run": "vitest run",
    "postinstall": "node scripts/copy-vad-models.js",
    "desktop:build": "powershell -ExecutionPolicy Bypass -File ../scripts/build-desktop.ps1",
    "desktop:dev": "npm run dev:electron"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@base-ui/react": "^1.4.1",
    "@google-cloud/speech": "^7.5.0",
    "@prisma/client": "^7.10.0",
    "@ricky0123/vad-react": "^0.0.36",
    "@ricky0123/vad-web": "^0.0.30",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^13.4.0",
    "geist": "^1.7.2",
    "lucide-react": "^1.46.0",
    "next": "16.2.6",
    "next-auth": "^4.24.15",
    "next-intl": "^4.11.0",
    "openai": "^6.49.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.6.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.4",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jsdom": "^29.1.1",
    "node-fetch": "^3.3.2",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.7",
    "wait-on": "^9.1.0"
  }
}