{
  "appId": "com.jubalisan.app",
  "productName": "JUBA LISAN",
  "artifactName": "JUBA-LISAN-${version}-${arch}.${ext}",
  "directories": {
    "output": "dist",
    "buildResources": "public"
  },
  "files": [
    "out/**/*",
    "electron/**/*",
    "package.json"
  ],
  "asar": true,
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "JUBA LISAN",
    "deleteAppDataOnUninstall": false
  },
  "portable": {
    "artifactName": "JUBA-LISAN-${version}-portable.${ext}"
  }
}
