{
  "appId": "com.jubalisan.app",
  "productName": "JUBA LISAN",
  "directories": {
    "output": "dist",
    "buildResources": "public"
  },
  "files": [
    "electron/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "desktop-backend",
      "to": "backend",
      "filter": [
        "juba-lisan-backend.exe"
      ]
    },
    {
      "from": "next-standalone",
      "to": "next-standalone",
      "filter": [
        "**/*"
      ]
    }
  ],
  "asar": true,
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "JUBA LISAN",
    "deleteAppDataOnUninstall": false
  }
}
