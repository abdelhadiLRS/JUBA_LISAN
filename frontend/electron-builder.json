{
  "appId": "com.jubalisan.app",
  "productName": "JUBA LISAN",
  "artifactName": "JUBA-LISAN-${version}-${arch}.${ext}",
  "directories": {
    "output": "dist",
    "buildResources": "public"
  },
  "files": [
    "out/**/*",
    "electron/**/*",
    "package.json"
  ],
  "asar": true,
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "public/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "JUBA LISAN",
    "deleteAppDataOnUninstall": false
  },
  "portable": {
    "artifactName": "JUBA-LISAN-${version}-portable.${ext}"
  },
  "mac": {
    "target": "dmg",
    "icon": "public/icon.icns"
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "icon": "public"
  }
}
