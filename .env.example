# JUBA LISAN local / self-hosted environment
# Copy this file to .env before running docker compose.

# PostgreSQL
POSTGRES_DB=juba_lisan
POSTGRES_USER=juba_lisan
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

# Host directory used by docker-compose bind mounts.
# A relative path is portable on Windows and Linux.
DATA_PATH=./docker-data

# Redis
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# JWT signing secret. Generate a random value of at least 32 characters.
SECRET_KEY=CHANGE_ME_SECRET_KEY_32_CHARS_MINIMUM

# Browser origins
CORS_ORIGINS=["http://localhost:3000"]
COOKIE_SECURE=false

# Registration
ALLOW_REGISTRATION=true
FIRST_USER_IS_ADMIN=true
BLOCKED_EMAIL_DOMAINS=["yopmail.com","mailinator.com","guerrillamail.com","temp-mail.org","throwaway.email","trashmail.com"]

# LLM: ollama, openai, anthropic, or deepseek
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Compatible with the local JUBA coder model; change to any Ollama model you have installed.
OLLAMA_MODEL=juba-coder

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Anthropic (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-4-5-haiku

# DeepSeek (optional)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Speech providers
# The default local endpoints expect the optional GPU profile:
#   docker compose --profile gpu up --build
# On CPU-only machines, leave the services stopped until a CPU speech provider is configured.
TTS_PROVIDER=local
TTS_BASE_URL=http://kokoro:8880
TTS_VOICE=af_heart
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova
OPENAI_TTS_SPEED=1.0

STT_PROVIDER=local
STT_BASE_URL=http://whisper:9000
STT_MODEL=large-v3-turbo
STT_ENGINE=faster_whisper
OPENAI_STT_MODEL=whisper-1

# Email / SMTP (optional)
EMAIL_ENABLED=false
CONTACT_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@jubalisan.com
SMTP_TLS=true
SMTP_SSL=false
APP_BASE_URL=http://localhost:3000

# Logging / local resource limits
LOG_LEVEL=INFO
# Keep this at 1 on the Surface Pro / low-memory development machines.
UVICORN_WORKERS=1

# Conversation defaults
DEFAULT_CONVERSATION_MAX_DURATION=1800
DEFAULT_CONVERSATION_INACTIVITY_TIMEOUT=180
DEFAULT_CONVERSATION_WEEKLY_SESSIONS=0
DEFAULT_CONVERSATION_DAILY_MINUTES=30
DEFAULT_CONVERSATION_WEEKLY_MINUTES=90
DEFAULT_MONTHLY_TOKENS_LIMIT=1000000
ASSESSMENT_VOICE_TRIAL_DURATION_SECONDS=300

# Freemium limits
FREEMIUM_CHAT_DAILY_MESSAGES=5
FREEMIUM_LESSONS_DAILY=3
FREEMIUM_LISTENING_WEEKLY=3
FREEMIUM_READING_WEEKLY=3
FREEMIUM_VOICE_WEEKLY_MINUTES=5
FREEMIUM_TRIAL_ENABLED=true
FREEMIUM_TRIAL_DAYS=7

# Target languages
AVAILABLE_TARGET_LANGUAGES=["de-DE","en-GB","en-US","es-ES","fr-FR","it-IT","ja-JP","ko-KR","pt-PT","zh-CN"]

# Stripe is disabled for local/self-hosted development.
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_TRIAL_DAYS=7
STRIPE_BASE_URL=http://localhost:3000
PRICE_MONTHLY=14.95
PRICE_YEARLY=149.50
TOTAL_PRICE_MONTHLY=19.95
TOTAL_PRICE_YEARLY=199.50

# Umami Analytics (optional)
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
